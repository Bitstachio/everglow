{
  "name": "everglow-image-processor",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "invoke": "tsx src/invoke-local.ts",
    "process-local": "tsx src/process-local.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.js && rm -f dist/function.zip && zip -j dist/function.zip dist/index.js"
  },
  "dependencies": {
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^22.10.7",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3"
  }
}
