{
  "name": "everglow-image-processor",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test node --import tsx --test src/*.spec.ts",
    "invoke": "tsx src/invoke-local.ts",
    "process-local": "tsx src/process-local.ts",
    "build": "node scripts/build-lambda.mjs",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "pino": "10.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^22.10.7",
    "esbuild": "^0.25.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1"
  }
}
