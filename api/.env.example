# Application
NODE_ENV=development
PORT=3000

# Logging
# Pino log level: trace | debug | info | warn | error | fatal | silent
# Defaults to "debug" outside production and "info" in production.
LOG_LEVEL=debug

# Rate limiting (docs/rate-limiting.md). Tiers and their defaults are declared in
# src/common/rate-limit/rate-limit.constants.ts; each is overridable here as
# RATE_LIMIT_<TIER>_LIMIT requests per RATE_LIMIT_<TIER>_TTL_SECONDS window.
# ON unless set to exactly "false".
# RATE_LIMIT_ENABLED=true
# default: every route, per client IP, shared across routes (flood ceiling)
# RATE_LIMIT_DEFAULT_LIMIT=1000
# RATE_LIMIT_DEFAULT_TTL_SECONDS=60
# sensitive: per user, per route (join, regenerate invite, onboarding, delete account)
# RATE_LIMIT_SENSITIVE_LIMIT=10
# RATE_LIMIT_SENSITIVE_TTL_SECONDS=60
# uploads: per user (upload-slot minting, up to 20 slots per request)
# RATE_LIMIT_UPLOADS_LIMIT=30
# RATE_LIMIT_UPLOADS_TTL_SECONDS=60
#
# Express "trust proxy": decides whether the client IP comes from X-Forwarded-For.
# OFF by default. Behind a load balancer set the number of proxy hops in front of
# the app (usually 1) or an address list ("loopback, 10.0.0.0/8"). Leaving it off
# behind a proxy charges every caller to the proxy's IP; "true" with no proxy in
# front lets any caller forge their address.
# TRUST_PROXY=false

# Database
# Password special chars must be URL-encoded
#
# Local PostgreSQL (native install, default port):
DATABASE_URL="postgresql://everglow_dev:everglow_pass@localhost:5432/everglow_db"
#
# Docker Compose DB from the host (npm run start:dev outside Docker):
# default POSTGRES_HOST_PORT is 5433 to avoid clashing with a native
# Postgres on 5432 — see docker-compose.yml
# DATABASE_URL="postgresql://everglow_dev:everglow_pass@localhost:5433/everglow_db"

# Auth0
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier

# Auth0 Management API
AUTH0_MANAGEMENT_CLIENT_ID=your-management-m2m-client-id
AUTH0_MANAGEMENT_CLIENT_SECRET=your-management-m2m-client-secret

# Sign in with Apple token revocation on account deletion (docs/authentication.md).
# Same Team ID, Key ID and .p8 key as the Auth0 Apple connection. CLIENT_ID is the
# identifier Auth0 presents to Apple for the login flow the app uses. The mobile
# app signs in through Universal Login (a browser flow), so this is the Services
# ID from the connection's "Client ID" field, not the iOS bundle identifier; a
# mismatch is a 400 invalid_client that is logged and never retried. Unset: Apple
# users are still deleted, and each deletion logs an error because their Apple
# token was not revoked. The Auth0 management app also needs read:users and
# read:user_idp_tokens.
# APPLE_SIWA_TEAM_ID=ABCDE12345
# APPLE_SIWA_KEY_ID=ABCDE12345
# APPLE_SIWA_CLIENT_ID=com.example.everglow.signin
# APPLE_SIWA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Account deletion reconciler: finishes sagas where Auth0 is gone (or deletion
# started) but the Postgres user row remains.
# OFF unless set to exactly "true". Enable it ONLY where this DATABASE_URL is the
# source of truth for the Auth0 tenant in AUTH0_DOMAIN. A dev or compose database
# plus the shared management credentials would delete other environments' real
# logins, and that cannot be undone.
# ACCOUNT_DELETION_RECONCILER_ENABLED=false
# ACCOUNT_DELETION_RECONCILER_BATCH_SIZE=50
# ACCOUNT_DELETION_RECONCILER_STUCK_AFTER_HOURS=1
# Failed passes before a saga stops being retried and is reported for manual recovery
# ACCOUNT_DELETION_MAX_ATTEMPTS=5

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-bucket-name

# Photo upload cleanup (stale PENDING rows; also releases the quota they hold).
# Slots whose upload URL expired with no object at the key are released on the
# next run regardless of MAX_AGE_HOURS; the age only applies to slots that did
# receive an object and were never confirmed.
# PHOTO_PENDING_CLEANUP_ENABLED=true
# PHOTO_PENDING_CLEANUP_MAX_AGE_HOURS=24
# PHOTO_PENDING_CLEANUP_BATCH_SIZE=100

# S3 orphan reconciler: daily sweep of S3 objects under the API's prefixes (photos/, avatars/)
# that no database row references. The variables keep their PHOTO_ names from when photos/ was
# the only prefix.
# OFF unless set to exactly "true". Enable it ONLY where this DATABASE_URL is the source of
# truth for AWS_S3_BUCKET. A dev or compose database plus the shared bucket credentials would
# delete other environments' live objects, and the bucket is not versioned.
# PHOTO_ORPHAN_RECONCILER_ENABLED=false
# Max deletions per run
# PHOTO_ORPHAN_RECONCILER_BATCH_SIZE=100
# Objects younger than this are never deleted (0 disables the buffer)
# PHOTO_ORPHAN_RECONCILER_MIN_OBJECT_AGE_HOURS=24

# Encryption (for photos)
ENCRYPTION_MASTER_KEY=your-32-byte-master-encryption-key-change-in-production

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,image/webp

# ---------------------------------------------------------------------------
# Docker Compose (optional overrides — defaults work out of the box)
# Copy this file to .env before running: docker compose up --build
#
# POSTGRES_DB=everglow_db
# POSTGRES_USER=everglow_dev
# POSTGRES_PASSWORD=everglow_pass
# POSTGRES_HOST_PORT=5433
# API_HOST_PORT=3000
#
# docker compose up: the api service overrides DATABASE_URL to use
# hostname "db" (not localhost). Auth0, AWS, and encryption vars
# above are still read from .env.
