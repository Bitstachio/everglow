generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum AccessLevel {
  ORGANIZER
  PARTICIPANT
  VIEWER
}

enum PhotoStatus {
  PENDING
  READY
}

/// What upload screening made of a photo (docs/moderation.md §11).
enum PhotoScreening {
  // Never sent: screening was off at confirm, or the photo predates it.
  UNSCREENED
  // Held until screened: confirm couldn't finish the check, and the
  // screening job retries until screeningHeldUntil.
  PENDING
  // Screened; nothing above the threshold.
  CLEARED
  // Screened and flagged: it has (or had) an automated report.
  FLAGGED
  // Couldn't be screened (a format Rekognition can't read, or the hold ran
  // out), so it was published unchecked.
  SKIPPED
}

/// What happens to photos the account uploaded into events that outlive it.
/// Chosen by the caller and stored on the row, so the reconciler resumes a
/// saga with the choice the user actually made.
enum AccountDeletionPhotoPolicy {
  KEEP
  DELETE
}

/// What a report points at. Stored rather than derived from which foreign key
/// is set, because both keys are SET NULL: once the photo or the account is
/// gone, this is what still says what kind of thing was reported.
enum ReportTargetType {
  PHOTO
  MEMBER
  // The event itself (cover, title, description): reviewed by the platform
  // owner, never by the event's organizers. See docs/moderation.md.
  EVENT
}

enum ReportReason {
  SPAM
  NUDITY_OR_SEXUAL
  HARASSMENT
  VIOLENCE
  OTHER
  // Anything that sexualizes or endangers a minor. Only the platform handles
  // it, by the NCMEC and Cybertip.ca procedure (docs/moderation.md §7).
  CHILD_SAFETY
  // "An intimate image of me, shared without my consent": the TAKE IT DOWN
  // Act's 48-hour removal. Only the platform handles it (docs/moderation.md §7).
  NON_CONSENSUAL_INTIMATE_IMAGE
}

enum ReportStatus {
  OPEN
  // Someone who may judge it removed what was reported.
  ACTIONED
  // Judged and left as it is.
  DISMISSED
  // Closed without a verdict: what it was about was deleted. Never counts as
  // a verdict against anyone.
  TARGET_GONE
}

// Why a report left OPEN (docs/moderation.md §3). Verdicts close as ACTIONED
// or DISMISSED; PHOTO_DELETED and ACCOUNT_DELETED close as TARGET_GONE.
// REPORTER_REMOVED closes as DISMISSED: removing the reporter from the event
// is the remover's judgment that their reports there no longer count.
enum ReportClosedReason {
  PHOTO_REMOVED
  MEMBER_REMOVED
  ACCOUNT_SUSPENDED
  EVENT_SUSPENDED
  EVENT_DELETED
  DISMISSED
  PHOTO_DELETED
  ACCOUNT_DELETED
  REPORTER_REMOVED
}

// In which capacity a report was closed. resolvedById is the person, and is
// nulled with their account; the role survives it.
enum ReportActorRole {
  // An organizer of the report's event.
  ORGANIZER
  // A platform moderator.
  PLATFORM
  // The person the report is about, for example deleting their own photo.
  SUBJECT
  // A job or a cascade, with nobody acting.
  SYSTEM
}

model User {
  id                   String                      @id @default(uuid()) @db.Uuid
  providerSub          String                      @unique @db.VarChar(255)
  // Account deletion saga (see docs/account-deletion.md): null means that
  // phase has not happened. deletionStartedAt marks durable intent;
  // auth0DeletedAt marks that the IdP user is already gone.
  deletionStartedAt    DateTime?
  auth0DeletedAt       DateTime?
  // The caller's photo choice, captured with the intent so a resumed saga
  // honours it. Null until a deletion starts.
  deletionPhotoPolicy  AccountDeletionPhotoPolicy?
  // Failed reconciler passes. Bounded so a permanently stuck row is reported
  // once instead of alerting every hour forever.
  deletionAttempts     Int                         @default(0)
  // Lease of the saga pass running this deletion, a request or the reconciler.
  // Only the holder runs it, so two passes never race (docs/account-deletion.md §4).
  deletionClaimedUntil DateTime?
  // When the account accepted the terms of use (App Store guideline 1.2).
  // Null for accounts onboarded before the client sent `acceptedTerms`.
  termsAcceptedAt      DateTime?
  // Platform moderators act on any report, across events (docs/moderation.md
  // §8). Granted only in the database: no endpoint sets it.
  platformRole         PlatformRole?
  // Suspended by the platform (docs/moderation.md §8): every request but
  // reading and deleting the account answers 403 ACCOUNT_SUSPENDED.
  suspendedAt          DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  details           UserDetails?
  createdEvents     Event[]          @relation("CreatedEvents")
  eventAccesses     EventAccess[]
  photos            Photo[]
  // Moderation (see docs/moderation.md). Every relation below is SET NULL or
  // CASCADE, so none of them can block the account-deletion saga.
  reportsFiled      Report[]         @relation("ReportsFiled")
  reportsReceived   Report[]         @relation("ReportsReceived")
  reportsResolved   Report[]         @relation("ReportsResolved")
  blocksInitiated   UserBlock[]      @relation("BlocksInitiated")
  blocksReceived    UserBlock[]      @relation("BlocksReceived")
  eventBans         EventBan[]       @relation("EventBansReceived")
  usernameChanges   UsernameChange[]
  eventCoversSet    Event[]          @relation("EventCoversSet")
  eventsDeactivated Event[]          @relation("EventsDeactivated")
  eventBansIssued   EventBan[]       @relation("EventBansIssued")
  // Push notifications (docs/notifications.md). Cascade with the account.
  devices           UserDevice[]
  notifications     Notification[]

  // Reconciler looks up users mid-deletion; only those rows are indexed.
  @@index([deletionStartedAt], where: { deletionStartedAt: { not: null } })
}

// Tombstone for a deleted Auth0 identity (see docs/authentication.md).
// Blocks JIT provisioning when an in-flight access token outlives the User row.
model DeletedProviderSub {
  /// SHA-256 of the Auth0 sub. Hashed because this table outlives the accounts
  /// in it: it must answer "have I seen this subject?" without becoming a
  /// readable list of the identities that asked to be forgotten.
  providerSubHash String    @id @db.VarChar(64)
  formerUserId    String    @db.Uuid
  deletedAt       DateTime  @default(now())
  // The account was suspended when it was deleted (docs/account-deletion.md
  // §6a). A sign-in after the deletion creates the new account already
  // suspended and clears this; lifting the suspension clears it too.
  suspendedAt     DateTime?

  // Event bans the account had when it was deleted, re-created on a sign-in.
  bans CarriedBan[]

  // The reconciler's purge: tombstones past the base window.
  @@index([deletedAt])
  // Lifting the suspension of an account that has since been deleted.
  @@index([formerUserId])
}

// An event ban carried over a deletion (docs/account-deletion.md §6a). A
// sign-in after the deletion turns these back into EventBan rows for the new
// account. Goes with the event, and with the tombstone when it is purged.
model CarriedBan {
  providerSubHash String   @db.VarChar(64)
  eventId         String   @db.Uuid
  // EventBan.createdAt of the ban that was carried over.
  bannedAt        DateTime

  tombstone DeletedProviderSub @relation(fields: [providerSubHash], references: [providerSubHash], onDelete: Cascade)
  event     Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([providerSubHash, eventId])
  // The foreign key the event's cascade has to find.
  @@index([eventId])
}

// S3 work an account deletion owes once its database changes have committed
// (docs/account-deletion.md §4). Prep writes it in its own transaction, so a
// pass that fails afterwards (Auth0, Apple, a crash) leaves the work on record
// instead of in memory. Drained right after that commit, again by a resumed
// saga, and by the reconciler for anything left behind. No foreign key to the
// user: the work outlives the row.
model AccountDeletionOutbox {
  id          String                      @id @default(uuid()) @db.Uuid
  userId      String                      @db.Uuid
  action      AccountDeletionOutboxAction
  // PURGE: the object to delete, with its derived copies. REKEY: the
  // original to move away from.
  s3Key       String                      @db.VarChar(255)
  // REKEY only: the photo being moved, and the key it moves to.
  photoId     String?                     @db.Uuid
  targetS3Key String?                     @db.VarChar(255)
  // Drains that failed for this entry; past a bound it is left to the S3
  // orphan reconciler.
  attempts    Int                         @default(0)
  createdAt   DateTime                    @default(now())

  // A resumed prep queues the same keys again; they are one entry.
  @@unique([action, s3Key])
  @@index([userId])
  @@index([createdAt])
}

enum AccountDeletionOutboxAction {
  PURGE
  REKEY
}

model UserDetails {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  // Public handle. Required after backfill; unique and stored lowercase.
  // See EV-21.
  username    String   @unique @db.VarChar(30)
  name        String   @db.VarChar(255)
  // S3 key of the profile avatar (avatars/{userId}/{uploadId}); null when none
  // is set. Unique so the orphan reconciler resolves a page of keys with one
  // indexed lookup. See docs/image-uploads.md.
  avatarS3Key String?  @unique @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Which plan a Plan row is a version of (docs/event-quotas.md). Paid plans
// are added here later.
enum EventPlan {
  FREE
}

// A plan's terms: what an event on it may hold and for how long
// (docs/event-quotas.md). Rows are immutable once written (a trigger refuses
// updates): changing a plan means inserting its next version, so every event
// keeps the terms it was created or bought with. New events get the highest
// version of their plan's code. A new kind of limit is a new column here,
// never on Event.
model Plan {
  id                   String    @id @default(uuid()) @db.Uuid
  code                 EventPlan
  version              Int
  // Members of every role, organizers included; null means no limit.
  memberLimit          Int?
  // The gallery's storage, the one limit on what it holds; null means no limit.
  storageLimitBytes    BigInt?
  // The longest a gallery on this plan stays open, in days; null never closes.
  galleryWindowDays    Int?
  // The lengths a host can pick when creating an event, in days. The longest
  // is galleryWindowDays (a check constraint holds it). Empty means the one
  // length above (the free plan before version 2).
  galleryWindowOptions Int[]     @default([])
  createdAt            DateTime  @default(now())

  events Event[]

  @@unique([code, version])
}

model Event {
  id                String    @id @default(uuid()) @db.Uuid
  title             String    @db.VarChar(100)
  description       String?   @db.Text
  date              DateTime
  // Attribution only; null once the creator's account is deleted. Who may
  // manage the event is decided by EventAccess, never by this column.
  creatorId         String?   @db.Uuid
  invitationUrl     String    @unique @db.VarChar(100)
  // S3 key of the cover image (event-covers/{eventId}/{uploadId}); null when
  // none is set. Unique so the orphan reconciler resolves a page of keys with
  // one indexed lookup. See docs/image-uploads.md.
  coverS3Key        String?   @unique @db.VarChar(255)
  // The organizer who set the current cover, so a reviewer of an event report
  // sees whose image it is. Null with no cover, or once that account is gone.
  coverUpdatedById  String?   @db.Uuid
  // Set when enough members report the event itself (docs/moderation.md,
  // "Under review"): no one can join and no photos can be added. Only the
  // platform clears it.
  underReviewAt     DateTime?
  // Suspended by the platform (docs/moderation.md §8): hidden and read-only
  // for its members until the platform restores it.
  suspendedAt       DateTime?
  // The plan version the event was created on (or upgraded to); its limits
  // come from that row.
  planId            String    @db.Uuid
  // Storage given to this event on top of its plan, e.g. an add-on or a
  // support grant. Added to the plan's storage limit.
  bonusStorageBytes BigInt    @default(0)
  // How long the host chose to keep the gallery open, in days: one of the
  // plan's options. Null on a plan that never closes.
  galleryWindowDays Int?
  // When uploads open: the later of the event's date and when the event was
  // created (or, while upcoming, rescheduled). Before this it is upcoming.
  galleryOpensAt    DateTime
  // When the gallery closes: galleryOpensAt plus galleryWindowDays. Fixed once
  // the gallery opens. Null on a plan that never closes.
  galleryClosesAt   DateTime?
  // When the close job removed the gallery's photos. The event stays.
  galleryClosedAt   DateTime?
  // When an organizer deactivated the event, which set galleryClosesAt to
  // that moment. Null when the gallery closes on schedule.
  deactivatedAt     DateTime?
  // The organizer who deactivated it; null once that account is deleted.
  deactivatedById   String?   @db.Uuid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  creator        User?         @relation("CreatedEvents", fields: [creatorId], references: [id], onDelete: SetNull)
  coverUpdatedBy User?         @relation("EventCoversSet", fields: [coverUpdatedById], references: [id], onDelete: SetNull)
  deactivatedBy  User?         @relation("EventsDeactivated", fields: [deactivatedById], references: [id], onDelete: SetNull)
  // Restrict: a plan version some event uses can never be deleted.
  plan           Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  photos         Photo[]
  eventAccesses  EventAccess[]
  invites        EventInvite[]
  reports        Report[]
  bans           EventBan[]
  // Bans of deleted accounts, waiting on their tombstone for a sign-in.
  carriedBans    CarriedBan[]

  @@index([creatorId])
  @@index([coverUpdatedById])
  @@index([deactivatedById])
  @@index([planId])
  // The close job's hourly lookups: open galleries past their close time, and
  // closed galleries still holding photos (docs/photos-architecture.md §12).
  @@index([galleryClosedAt, galleryClosesAt])
}

/// One shareable join token per access level for an event. Joining via the
/// token grants that accessLevel. Event.invitationUrl stays in sync with the
/// PARTICIPANT token for older clients that only know a single invite URL.
model EventInvite {
  id          String      @id @default(uuid()) @db.Uuid
  eventId     String      @db.Uuid
  token       String      @unique @db.VarChar(100)
  accessLevel AccessLevel
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, accessLevel])
  @@index([eventId])
}

model EventAccess {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  eventId     String      @db.Uuid
  accessLevel AccessLevel @default(VIEWER)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // A deleted account takes its memberships with it.
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
}

model Photo {
  id                 String         @id @default(uuid()) @db.Uuid
  s3Key              String         @unique @db.VarChar(255)
  contentType        String         @db.VarChar(100)
  sizeBytes          Int
  status             PhotoStatus    @default(PENDING)
  // Hex SHA-256 of the original's bytes, computed by the API at confirm. Null
  // while PENDING, for photos from before it was recorded until the hash
  // backfill reaches them, and when hashing failed at confirm. Identical
  // copies of a removed intimate image are found by it (docs/moderation.md §7).
  sha256             String?        @db.Char(64)
  // Upload screening (docs/moderation.md §11), decided at confirm. UNSCREENED
  // when screening was off then, and for photos from before it existed.
  screening          PhotoScreening @default(UNSCREENED)
  // While PENDING: until when only the uploader and the event's organizers
  // see the photo. The read filter lets it through after this even if it was
  // never screened, so nothing stays hidden for good. Null otherwise.
  screeningHeldUntil DateTime?
  // Null once the uploader's account is deleted and the photo was kept for the
  // event. It still counts toward the event's gallery storage.
  addedById          String?        @db.Uuid
  eventId            String         @db.Uuid
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  addedBy User?    @relation(fields: [addedById], references: [id], onDelete: SetNull)
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([eventId, status, createdAt])
  @@index([addedById])
  @@index([status, createdAt])
  // Identical copies of a removed image, and the backfill's IS NULL scan.
  @@index([sha256])
  // The screening job's queue of held photos, soonest deadline first.
  @@index([screeningHeldUntil], where: { screening: "PENDING" })
}

// A member's report of a photo or of another member (see docs/moderation.md).
// The migration adds CHECK constraints Prisma cannot express: a MEMBER report
// never carries a photoId, reporter and reported user differ, and the
// resolution columns agree with the status.
model Report {
  id                      String              @id @default(uuid()) @db.Uuid
  // Null once the event is deleted. An event with OPEN reports can't be
  // deleted, so only closed reports outlive it (docs/moderation.md §7).
  eventId                 String?             @db.Uuid
  // The event's title when the report was filed, so a report still says where
  // it came from after the event is gone. Same length as Event.title.
  eventTitle              String              @db.VarChar(100)
  // Null once the reporter's account is deleted: the report stays as evidence.
  // Null from the start on an AUTOMATED report, which nobody filed.
  reporterId              String?             @db.Uuid
  // USER for a member's report; AUTOMATED for one upload screening filed
  // (docs/moderation.md §11). A trigger refuses a USER report without a
  // reporter at insert; SET NULL later still passes.
  source                  ReportSource        @default(USER)
  targetType              ReportTargetType
  // Set for PHOTO reports; null again once that photo is deleted.
  photoId                 String?             @db.Uuid
  // The reported member, or the uploader of the reported photo. Null once that
  // account is deleted, or when the photo had already lost its uploader.
  reportedUserId          String?             @db.Uuid
  reason                  ReportReason
  note                    String?             @db.VarChar(500)
  // Who handles it (docs/moderation.md §3): the event's organizers, or the
  // platform. A report never moves back from PLATFORM.
  queue                   ReportQueue         @default(ORGANIZERS)
  // Why the platform was told about it, at filing and at each move.
  escalationReasons       ReportEscalation[]  @default([])
  // When it moved to PLATFORM, or was filed there.
  escalatedAt             DateTime?
  // When the platform was last told it is overdue: once 24 hours after it got
  // there, then weekly while it stays OPEN (docs/moderation.md §9).
  overdueAlertedAt        DateTime?
  // The legal removal deadline: 48 hours from filing for an intimate image
  // (TAKE IT DOWN Act), null otherwise (docs/moderation.md §7).
  removalDueAt            DateTime?
  // When the hourly check announced it 12 hours before, and after, that
  // deadline; each alert fires once.
  removalDueSoonAlertedAt DateTime?
  removalOverdueAlertedAt DateTime?
  status                  ReportStatus        @default(OPEN)
  // Why and in which capacity it closed; both null while OPEN. Reports closed
  // before these existed have neither.
  closedReason            ReportClosedReason?
  closedByRole            ReportActorRole?
  resolvedById            String?             @db.Uuid
  resolvedAt              DateTime?
  // The retention purge skips the report and its evidence until then
  // (docs/moderation.md §7). Only the platform sets a hold.
  holdUntil               DateTime?
  holdReason              ReportHoldReason?
  // The CyberTipline or police reference, once the platform has reported it
  // (docs/moderation.md §7).
  authorityReference      String?
  // When that report was submitted. The hold runs at least a year from it
  // (18 U.S.C. §2258A(h)).
  authorityReportedAt     DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  // Everything is SET NULL: deleting an event, a photo, a reporter, a reported
  // account or a resolver never fails on a report, and never erases one
  // either. Reports are the only lasting record of abuse.
  event        Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  reporter     User?           @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: SetNull)
  photo        Photo?          @relation(fields: [photoId], references: [id], onDelete: SetNull)
  reportedUser User?           @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: SetNull)
  resolvedBy   User?           @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  evidence     ReportEvidence?

  // One OPEN report per reporter and target, enforced by the database so two
  // concurrent submissions cannot both insert. Resolved reports are outside
  // the indexes, which is what lets a target be reported again later. The
  // photo index needs no targetType predicate (MEMBER reports have a null
  // photoId, and nulls never collide), which also lets it answer "which photos
  // has the caller an open report on?" in the photo read paths. The member
  // index does: PHOTO reports carry the uploader in reportedUserId too.
  @@unique([reporterId, photoId], where: { status: "OPEN" })
  @@unique([reporterId, eventId, reportedUserId], where: { status: "OPEN", targetType: "MEMBER" })
  // One OPEN report per member about the event itself.
  @@unique([reporterId, eventId], where: { status: "OPEN", targetType: "EVENT" })
  // One OPEN automated report per photo, so two screens of the same photo
  // (confirm and the screening job) can't both file one.
  @@unique([photoId], where: { status: "OPEN", source: "AUTOMATED" })
  // Organizer queue (status filter, newest first) and the per-event lookup of
  // photos whose open reports reached the hide threshold.
  @@index([eventId, status, createdAt])
  // Foreign keys the SET NULL actions have to find.
  @@index([photoId])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([resolvedById])
  // The retention purge: closed reports past the window, holds checked per row.
  @@index([status, resolvedAt])
  // The platform queue, oldest first, and the overdue check.
  @@index([queue, status, escalatedAt])
  // The hourly removal-deadline check; null for every report but intimate images.
  @@index([removalDueAt])
}

// "blocker does not want to see blocked". Directional in storage, symmetric in
// effect (see docs/moderation.md). The migration adds a CHECK that the two ids
// differ. Both sides cascade: a block means nothing once either account is gone.
model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// A member an organizer removed from an event: joining it again through the
// invitation link is refused until an organizer lifts the ban. Leaving on
// your own records nothing. See docs/moderation.md.
model EventBan {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @db.Uuid
  userId     String   @db.Uuid
  // The organizer who removed them; null once that account is deleted.
  bannedById String?  @db.Uuid
  createdAt  DateTime @default(now())

  // A ban belongs to the event and to the banned account, and goes with
  // either; the organizer who issued it is attribution only.
  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User  @relation("EventBansReceived", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy User? @relation("EventBansIssued", fields: [bannedById], references: [id], onDelete: SetNull)

  // The join check and "ban again is a no-op" both look up this pair; the
  // organizer's list is the same index read by eventId.
  @@unique([eventId, userId])
  // Foreign keys the cascade and SET NULL actions have to find.
  @@index([userId])
  @@index([bannedById])
}

// Every change of a username after onboarding. Instagram-style limit: a user
// may change their username a few times per rolling window
// (USERNAME_CHANGE_LIMIT, USERNAME_CHANGE_WINDOW_DAYS in users.constants.ts).
// Keeping the old handle also leaves room to hold released names for a
// cool-down later (EV-30).
model UsernameChange {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  oldUsername String   @db.VarChar(30)
  newUsername String   @db.VarChar(30)
  changedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The limit check: this user's changes inside the window, oldest first.
  @@index([userId, changedAt])
}

// Why the platform holds a report and its evidence past the retention window.
enum ReportHoldReason {
  CHILD_SAFETY
  INTIMATE_IMAGE
  LAW_ENFORCEMENT
  LEGAL
}

// What a report was about, as it was when the report was filed
// (docs/moderation.md §7). No foreign keys to the photo, the event or the
// subject: it has to outlive all three. It lives exactly as long as its
// report.
model ReportEvidence {
  id                 String    @id @default(uuid()) @db.Uuid
  reportId           String    @unique @db.Uuid
  // The reported object: the photo for a PHOTO report, the event's cover for
  // an EVENT report. Null for a MEMBER report, or an event with no cover.
  objectS3Key        String?
  contentType        String?
  sizeBytes          Int?
  // The quarantined copy under evidence/, made before the original is
  // deleted. Null while the original still exists, or while the copy failed.
  evidenceS3Key      String?   @unique
  // Hex SHA-256 of the copy, computed by S3 while copying.
  sha256             String?   @db.Char(64)
  quarantinedAt      DateTime?
  // A delete was asked for while the copy failed: the original is kept, and
  // the daily evidence job retries the copy.
  quarantineFailedAt DateTime?
  // The reported member, the photo's uploader, or who set the cover.
  subjectUserId      String?   @db.Uuid
  subjectUsername    String?
  createdAt          DateTime  @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // Delete paths look evidence up by the key they are about to delete.
  @@index([objectS3Key])
  // The retry pass.
  @@index([quarantineFailedAt])
  // Confirm refuses a photo whose hash matches a removed intimate image.
  @@index([sha256])
}

// Who handles a report (docs/moderation.md §3).
enum ReportQueue {
  ORGANIZERS
  PLATFORM
}

// Why a report reached the platform. Logged lowercase, as the
// `escalationReasons` of `report.escalated` (docs/moderation.md §9).
enum ReportEscalation {
  SEVERE_REASON
  TARGET_IS_ORGANIZER
  TARGET_IS_SOLE_ORGANIZER
  TARGET_IS_EVENT
  HIDE_THRESHOLD_REACHED
  EVENT_UNDER_REVIEW
  ORGANIZER_TIMEOUT
  GALLERY_CLOSED
  SEVERE_DISMISSED
  TARGET_DELETED
  CHILD_SAFETY
  INTIMATE_IMAGE
  // Upload screening flagged the photo (docs/moderation.md §11).
  AUTOMATED_FLAG
}

// Who filed a report (docs/moderation.md §1, §11).
enum ReportSource {
  // A member: the reporterId, until their account is deleted.
  USER
  // Upload screening. Never has a reporter.
  AUTOMATED
}

// A role on the platform itself, above any event (docs/moderation.md §8).
enum PlatformRole {
  MODERATOR
}

// Which kind of phone a push token belongs to.
enum DevicePlatform {
  IOS
  ANDROID
}

// A phone that receives push notifications for the account signed in on it
// (docs/notifications.md §2). One row per push token: when a phone signs in
// to another account, its row moves to that account.
model UserDevice {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  // The Expo push token (ExponentPushToken[…]). Never logged and never
  // returned: whoever holds it can address the phone.
  token      String         @unique @db.VarChar(255)
  platform   DevicePlatform
  // The phone's language as a BCP 47 tag (en-CA), for translated copy later.
  locale     String?        @db.VarChar(35)
  createdAt  DateTime       @default(now())
  // Set on every registration. A phone registers each time the app opens
  // signed in, so a token not seen for months belongs to a phone that is gone.
  lastSeenAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Phones nobody has opened the app on for months (docs/notifications.md §5).
  @@index([lastSeenAt])
  // A user's devices, newest first: sending, and keeping the newest few.
  @@index([userId, lastSeenAt])
}

// What a notification is about. Its copy, link and dedupe key live in
// src/notifications/notification-catalogue.ts, which must cover every value.
enum NotificationType {
  // Internal: checks the whole path from the API to a phone
  // (pnpm run notifications:send-test).
  TEST
}

enum NotificationStatus {
  // Waiting for the sender, or for its next attempt.
  PENDING
  // Expo accepted it for at least one phone.
  SENT
  // Not sent, and will not be: every phone refused it, or attempts ran out.
  FAILED
  // Nothing to send to: no phones, or the account is being deleted.
  SKIPPED
}

// The outbox and the history in one table (docs/notifications.md §3).
// NotificationsService.notify writes rows in the caller's transaction; the
// sender sends them after the commit, and a job retries what is left. Kept
// for NOTIFICATION_RETENTION_DAYS, then deleted with its deliveries.
model Notification {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @db.Uuid
  type          NotificationType
  // The ids the copy and link are built from, typed per type in the
  // catalogue. Never text a person wrote.
  data          Json
  // One notification per key: notifying twice with the same key is a no-op.
  dedupeKey     String             @unique @db.VarChar(255)
  status        NotificationStatus @default(PENDING)
  // Sender passes that claimed it. Bounded by NOTIFICATION_MAX_ATTEMPTS.
  attempts      Int                @default(0)
  // Not sent before this: retries back off.
  nextAttemptAt DateTime           @default(now())
  // Lease of the sender pass holding it, so two instances never send it twice.
  claimedUntil  DateTime?
  sentAt        DateTime?
  // Why it is not SENT: an Expo error code or a short reason, never a token.
  lastError     String?            @db.VarChar(255)
  createdAt     DateTime           @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  // The sender's queue: due PENDING rows.
  @@index([status, nextAttemptAt])
  // Retention.
  @@index([createdAt])
  // A user's notifications: the cascade when an account is deleted.
  @@index([userId, createdAt])
}

enum NotificationDeliveryStatus {
  // Expo accepted it and gave a ticket; the receipt is not checked yet.
  TICKETED
  // The receipt says Apple or Google accepted it.
  DELIVERED
  // Expo or the receipt refused it.
  FAILED
}

// One phone's copy of a notification: the Expo ticket, then its receipt.
model NotificationDelivery {
  id             String                     @id @default(uuid()) @db.Uuid
  notificationId String                     @db.Uuid
  // No foreign key: the phone may be unregistered before the receipt arrives.
  deviceId       String                     @db.Uuid
  status         NotificationDeliveryStatus
  // Expo's ticket id, which its receipt is looked up by. Null when refused.
  ticketId       String?                    @unique @db.VarChar(64)
  // Expo's error code (DeviceNotRegistered, MessageTooBig, ...).
  error          String?                    @db.VarChar(64)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  // Receipts to check.
  @@index([status, createdAt])
}
