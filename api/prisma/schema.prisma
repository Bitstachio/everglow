generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum AccessLevel {
  ORGANIZER
  PARTICIPANT
  VIEWER
}

enum PhotoStatus {
  PENDING
  READY
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  providerSub       String   @unique @db.VarChar(255)
  // Photo storage ceiling in bytes. Defaults to the free tier (5 GiB); keep in
  // sync with FREE_TIER_STORAGE_LIMIT_BYTES in src/photos/photos.constants.ts.
  // Billing raises it per account; usage stays computed from Photo rows.
  storageLimitBytes BigInt   @default(5368709120)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  details       UserDetails?
  createdEvents Event[]       @relation("CreatedEvents")
  eventAccesses EventAccess[]
  photos        Photo[]
}

model UserDetails {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  email     String   @unique @db.VarChar(255)
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id            String   @id @default(uuid()) @db.Uuid
  title         String   @db.VarChar(100)
  description   String?  @db.Text
  date          DateTime
  // Attribution only; null once the creator's account is deleted. Who may
  // manage the event is decided by EventAccess, never by this column.
  creatorId     String?  @db.Uuid
  invitationUrl String   @unique @db.VarChar(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creator       User?         @relation("CreatedEvents", fields: [creatorId], references: [id], onDelete: SetNull)
  photos        Photo[]
  eventAccesses EventAccess[]

  @@index([creatorId])
}

model EventAccess {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  eventId     String      @db.Uuid
  accessLevel AccessLevel @default(VIEWER)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // A deleted account takes its memberships with it.
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
}

model Photo {
  id          String      @id @default(uuid()) @db.Uuid
  s3Key       String      @unique @db.VarChar(255)
  contentType String      @db.VarChar(100)
  sizeBytes   Int
  status      PhotoStatus @default(PENDING)
  // Null once the uploader's account is deleted and the photo was kept for
  // the event (see docs/account-deletion.md). Usage is summed per uploader,
  // so such photos count toward nobody's quota.
  addedById   String?     @db.Uuid
  eventId     String      @db.Uuid
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  addedBy User? @relation(fields: [addedById], references: [id], onDelete: SetNull)
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, status, createdAt])
  @@index([addedById])
  @@index([status, createdAt])
}

// Tombstone of a deleted account. Access tokens outlive the row they were
// issued for, and an unknown subject is otherwise provisioned as a new user on
// its first request, so the deletion timestamp is what stops a still-valid
// token from resurrecting the account. The subject is stored hashed: the
// table must not become a directory of identities that asked to be forgotten.
model DeletedAccount {
  id              String   @id @default(uuid()) @db.Uuid
  providerSubHash String   @unique @db.VarChar(64)
  // The id the account had, for log correlation only; nothing references it.
  userId          String   @db.Uuid
  deletedAt       DateTime @default(now())
}
