{
  "name": "everglow-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "maestro test --format junit --output .maestro/results/report.xml --test-output-dir .maestro/results --debug-output .maestro/results .maestro",
    "test:e2e:ios": "pnpm run test:e2e --platform ios -e APP_ID=com.anonymous.everglow-mobile",
    "test:e2e:android": "pnpm run test:e2e --platform android -e APP_ID=com.anonymous.everglowmobile",
    "lint": "eslint app components constants context features hooks lib providers",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "openapi:generate": "openapi-ts && prettier --write lib/api/generated",
    "openapi:check": "pnpm run openapi:generate && git diff --exit-code lib/api/generated",
    "openapi-ts": "openapi-ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.13.2",
    "expo": "~56.0.22",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.26",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.13",
    "expo-image-picker": "~56.0.25",
    "expo-linking": "~56.0.18",
    "expo-media-library": "~56.0.11",
    "expo-router": "~56.2.21",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.15",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.7",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "nativewind": "^5.0.0-preview.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.87.0",
    "react-native": "0.85.3",
    "react-native-auth0": "^5.7.0",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-qrcode-svg": "^6.3.20",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "postcss": "^8.5.28",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-native-svg-transformer": "^1.5.3",
    "tailwindcss": "^4.3.3",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
